FROM python:3.12.14-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY services/api/src ./services/api/src
COPY scripts/runtime_smoke.py ./scripts/runtime_smoke.py
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH=/app/services/api/src PYTHONUNBUFFERED=1
RUN useradd --uid 1000 --create-home rag && mkdir -p /var/lib/rag/artifacts && chown rag /var/lib/rag/artifacts
USER rag
CMD ["uvicorn", "rag_api.main:runtime_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
